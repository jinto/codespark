#!/bin/bash
set -e

echo "🔨 Pre-push: building + all tests (including integration + UI)..."

# UI tests have to bring the app to the front. A locked screen makes that
# impossible ("Failed to activate application ... Running Background"), which
# would block an otherwise fine push — so skip them and say so rather than
# reporting a failure that is really just the lock screen.
SKIP_UI=""
if ioreg -n Root -d1 -a 2>/dev/null | grep -A1 CGSSessionScreenIsLocked | grep -q true; then
  echo "⚠️  Screen is locked — skipping UI tests. Unlock and re-push to run them."
  SKIP_UI="-skip-testing:CodeSparkUITests"
elif [ -n "$SSH_CONNECTION" ]; then
  # Over ssh there is no window server to drive. The runner asks the console
  # session for permission to control it, that dialog opens on the physical
  # screen where nobody is looking, and XCTest gives up a minute later with
  # "Timed out while enabling automation mode" — after holding the push for
  # that minute. Say so instead.
  echo "⚠️  Pushing over ssh — skipping UI tests. Run them from the machine itself."
  SKIP_UI="-skip-testing:CodeSparkUITests"
else
  echo "   UI tests launch the app and take over focus for ~20s."
fi

# The sidebar tests need a project with more than one worktree. A checkout
# usually has one, so they skip — and a skip reads as a pass, which left the
# sidebar's only cover switched off. They cannot make one themselves: the test
# runner is sandboxed and git there is a shim over xcrun, which refuses inside a
# sandbox. So lend the repository a worktree here and take it back afterwards.
FIXTURE_WORKTREE=""
FIXTURE_BRANCH=""
if [ -z "$SKIP_UI" ] && [ "$(git worktree list --porcelain | grep -c '^worktree ')" -eq 1 ]; then
  FIXTURE_BRANCH="prepush-uitest-$$"
  FIXTURE_WORKTREE="$(mktemp -d)/$FIXTURE_BRANCH"
  if git worktree add "$FIXTURE_WORKTREE" -b "$FIXTURE_BRANCH" >/dev/null 2>&1; then
    echo "   Lent the repo a second worktree so the sidebar tests can run."
  else
    echo "⚠️  Could not create a worktree fixture — sidebar UI tests will skip."
    FIXTURE_WORKTREE=""
    FIXTURE_BRANCH=""
  fi
fi

cleanup_fixture() {
  [ -n "$FIXTURE_WORKTREE" ] || return 0
  git worktree remove --force "$FIXTURE_WORKTREE" >/dev/null 2>&1 || true
  git branch -D "$FIXTURE_BRANCH" >/dev/null 2>&1 || true
}
trap cleanup_fixture EXIT

DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer \
xcodebuild -project apps/macos/CodeSpark.xcodeproj \
  -scheme CodeSpark \
  -configuration Debug \
  -destination 'platform=macOS,arch=arm64' \
  -quiet \
  build-for-testing

DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer \
xcodebuild -project apps/macos/CodeSpark.xcodeproj \
  -scheme CodeSpark \
  -configuration Debug \
  -destination 'platform=macOS,arch=arm64' \
  -quiet \
  test-without-building \
  $SKIP_UI

echo "✅ All tests passed."
